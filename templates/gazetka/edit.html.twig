                                    <option value="fluent-emoji-flat">Fluent Emoji Flat (Microsoft)</option>
                                    <option value="emojione">EmojiOne (kolorowe)</option>
                                </optgroup>
                                <optgroup label="🏢 Logotypy marek">
                                    <option value="logos">Logos kolorowe (1861)</option>
