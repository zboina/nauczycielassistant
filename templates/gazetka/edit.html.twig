                                        <div class="b" style="width:80%;"></div>
                                        <div class="b" style="width:70%;"></div>
                                    </div>
                                    <div class="fw-bold mt-2">Okładka</div>
                                    <div class="text-secondary small">Tytuł, duże zdjęcie i spis treści.</div>
                                </div>
                            </button>
                        </div>
