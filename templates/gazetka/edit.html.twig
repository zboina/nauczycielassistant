                    </div>
                    <div class="d-flex gap-1 mb-2 flex-wrap">
                        <button type="button" class="btn btn-sm btn-outline-primary" data-action="gazetka-editor#cropFitCover" title="Kadr wypełnia ramkę: największy prostokąt o proporcjach ramki w obrazie (centrowany)"><i class="ti ti-aspect-ratio me-1"></i>Wypełnij ramkę</button>
                        <button type="button" class="btn btn-sm btn-outline-primary" data-action="gazetka-editor#cropMatchFrame" title="Dopasuj proporcje kadru do ramki (zachowując środek)"><i class="ti ti-frame me-1"></i>Proporcje ramki</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" data-action="gazetka-editor#cropFitContain" title="Cały obraz w kadrze (ramka dostosuje się do jego proporcji)"><i class="ti ti-zoom-out-area me-1"></i>Cały obraz</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary ms-auto" data-action="gazetka-editor#resetCrop" data-bs-dismiss="modal" title="Usuń kadr (pokaż cały obraz)"><i class="ti ti-rotate-2 me-1"></i>Resetuj kadr</button>
