                                <option value="photo">Zdjęcia</option>
                                <option value="all">Wszystko</option>
                            </select>
                        </div>
                        <div class="col-auto" data-stock="orientBox">
                            <label class="form-label">Orientacja</label>
                            <select class="form-select" data-stock="orientation">
                                <option value="all" selected>Dowolna</option>
                                <option value="landscape">Pozioma</option>
                                <option value="portrait">Pionowa</option>
                                <option value="squarish">Kwadrat</option>
                            </select>
                        </div>
                        <div class="col-auto">
                            <button type="button" class="btn btn-primary" data-action="gazetka-editor#searchStock"><i class="ti ti-search me-1"></i>Szukaj</button>
                        </div>
                    </div>
                    <div class="small mb-2 text-secondary" data-stock="status">Wpisz hasło i kliknij „Szukaj". <strong>Unsplash</strong>: hi-res zdjęcia (do druku). <strong>Pixabay</strong>: ilustracje/clipart (transparentne tło).</div>
                    <div class="row row-cols-3 row-cols-md-5 g-2" data-stock="results"></div>
                </div>
            </div>
        </div>
