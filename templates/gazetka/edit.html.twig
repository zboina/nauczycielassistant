{% extends 'base.html.twig' %}

{% block title %}{{ newsletter.title }} — Edytor gazetki{% endblock %}

{% block stylesheets %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;700&family=Open+Sans:wght@400;700&family=Lato:wght@400;700&family=Montserrat:wght@400;700&family=Oswald:wght@400;700&family=Raleway:ital,wght@0,400;0,700;1,400;1,700&family=Lora:wght@400;700&family=Merriweather:wght@400;700&family=Playfair+Display:wght@400;700&family=Kalam:wght@400;700&display=swap" rel="stylesheet">
<style>
    /* Krój z szerokim pokryciem symboli (znaki specjalne) — ten sam, którego używa eksport PDF, więc ekran = wydruk. */
    @font-face { font-family:'DejaVu Sans'; src:url('/fonts/gazetka/dejavu-sans-400.ttf') format('truetype'); font-display:swap; }
    body { background:#e9edf2 !important; overflow:hidden; }
    .gz-app { display:flex; flex-direction:column; height:100vh; }
    .gz-topbar { display:flex; align-items:center; gap:.5rem; padding:.45rem .75rem; background:#fff; border-bottom:1px solid #e3e6ea; flex-shrink:0; }
    .gz-topbar .gz-title { border:1px solid transparent; border-radius:.375rem; font-weight:600; font-size:1rem; padding:.25rem .5rem; max-width:280px; }
    .gz-topbar .gz-title:hover, .gz-topbar .gz-title:focus { border-color:#cdd3da; outline:none; }
    .gz-status { font-size:.78rem; color:#626976; min-width:120px; }
    .gz-main { flex:1; display:flex; min-height:0; }
    .gz-toolbar { width:58px; background:#fff; border-right:1px solid #e3e6ea; padding:.4rem; display:flex; flex-direction:column; gap:.3rem; overflow-y:auto; flex-shrink:0; transition:width .15s ease; }
    .gz-toolbar .btn { width:42px; height:42px; padding:0; display:flex; align-items:center; justify-content:center; }
    .gz-toolbar .btn .gz-label { display:none; }
    .gz-toolbar .gz-sep { height:1px; background:#e3e6ea; margin:.25rem 2px; }
    .gz-toolbar .gz-cap { display:none; }
    /* Rozwinięty pasek — ikony z opisami i nagłówkami sekcji */
    .gz-toolbar--expanded { width:206px; }
    .gz-toolbar--expanded .btn { width:100%; height:38px; justify-content:flex-start; gap:.6rem; padding:0 .7rem; font-size:.85rem; }
    .gz-toolbar--expanded .btn i { font-size:1.05rem; flex-shrink:0; }
    .gz-toolbar--expanded .btn .gz-label { display:inline; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .gz-toolbar--expanded .gz-sep { display:none; }
    .gz-toolbar--expanded .gz-cap { display:block; font-size:.66rem; text-transform:uppercase; letter-spacing:.04em; color:#94a0ad; font-weight:600; padding:.5rem .2rem .1rem; }
    .gz-canvas-wrap { flex:1; overflow:auto; display:grid; grid-template-columns:22px 1fr; grid-template-rows:22px 1fr; background:#e9edf2; }
    .gz-ruler { background:linear-gradient(180deg,#f1f4f8,#e6ebf3); user-select:none; position:sticky; z-index:4; }
    .gz-ruler--corner { grid-column:1; grid-row:1; top:0; left:0; z-index:5; text-align:center; line-height:22px; font-size:.65rem; color:#6c7793; font-weight:600; cursor:context-menu; border-right:1px solid #cdd3da; border-bottom:1px solid #cdd3da; }
    .gz-ruler--top  { grid-column:2; grid-row:1; top:0; cursor:ns-resize; border-bottom:1px solid #cdd3da; }
    .gz-ruler--left { grid-column:1; grid-row:2; left:0; cursor:ew-resize; border-right:1px solid #cdd3da; }
    .gz-ruler:hover { background:linear-gradient(180deg,#e8eef7,#dde5f0); }
    .gz-stage-area { grid-column:2; grid-row:2; padding:1.5rem; display:flex; justify-content:center; align-items:flex-start; }
    .gz-stage { line-height:0; }
    .gz-props { width:286px; background:#f7f9fc; border-left:1px solid #e3e6ea; padding:.6rem .65rem; overflow-y:auto; flex-shrink:0; font-size:.84rem; }
    .gz-props .form-label { font-size:.7rem; text-transform:uppercase; letter-spacing:.03em; color:#828a96; margin-bottom:.15rem; font-weight:600; }
    .gz-props .gz-group { padding:0; margin:0 0 .25rem; border-bottom:none; }
    .gz-props .gz-row { display:flex; gap:.4rem; }
    .gz-props .gz-row > * { flex:1; }
    .gz-props input.form-control, .gz-props select.form-select, .gz-props textarea.form-control { font-size:.82rem; padding:.2rem .45rem; }
    .gz-props input[type=color] { height:30px; padding:2px; }
    .gz-props .form-check { font-size:.8rem; min-height:1.2rem; padding-left:1.6em; }
    .gz-props .form-check-input { margin-left:-1.6em; }
    /* Zwijalne sekcje (details + summary) — kompaktowe i spójne */
    .gz-props .gz-sec { border:1px solid #e3e6ea; border-radius:7px; margin:0 0 .35rem; background:#fff; overflow:hidden; }
    .gz-props .gz-sec > summary {
        list-style:none; cursor:pointer; padding:.4rem .55rem;
        font-size:.72rem; font-weight:700; text-transform:uppercase; letter-spacing:.04em; color:#4a5568;
        display:flex; align-items:center; gap:.45rem; user-select:none;
    }
    .gz-props .gz-sec > summary::-webkit-details-marker { display:none; }
    .gz-props .gz-sec > summary::marker { content:""; display:none; }
    .gz-props .gz-sec > summary:hover { background:#f3f5f8; }
    .gz-props .gz-sec > summary > i.ti { font-size:1rem; color:#6c7793; flex-shrink:0; }
    .gz-props .gz-sec[open] > summary > i.ti.gz-sec-icon { color:#5b21b6; }
    .gz-props .gz-sec > summary > .gz-sec-title { flex:1 1 auto; }
    .gz-props .gz-sec > summary > .gz-chev { color:#9aa3af; font-size:.95rem; transition:transform .15s ease; }
    .gz-props .gz-sec[open] > summary > .gz-chev { transform:rotate(180deg); }
    .gz-props .gz-sec__body { padding:.45rem .55rem .55rem; border-top:1px solid #eef1f4; background:#fff; }
    /* Banner ze wskazówką */
    .gz-props .gz-tip {
        display:flex; gap:.45rem; padding:.45rem .55rem; margin:0 0 .45rem;
        background:#eef5ff; border:1px solid #d4e2f5; border-radius:6px;
        font-size:.7rem; color:#3a4a66; line-height:1.4;
    }
    .gz-props .gz-tip i.ti { color:#1a56db; flex-shrink:0; font-size:.95rem; margin-top:1px; }
    .gz-props .gz-tip kbd { font-size:.65rem; padding:.05rem .25rem; }
    /* Pływające okienko (paleta) — przeciągane, zwijalne */
    .gz-float {
        position:fixed; z-index:1040;
        background:#fff; border:1px solid #cdd5e0; border-radius:8px;
        box-shadow:0 14px 34px rgba(15,30,60,.22), 0 2px 6px rgba(15,30,60,.08);
        font-size:.84rem; min-width:240px; max-width:340px;
        user-select:none;
    }
    .gz-float[hidden] { display:none !important; }
    .gz-float__head {
        display:flex; align-items:center; gap:.4rem;
        padding:.4rem .55rem; background:linear-gradient(180deg,#f4f7fb,#e8eef6);
        border-bottom:1px solid #d3dbe6; border-radius:8px 8px 0 0;
        cursor:move;
    }
    .gz-float--dragging .gz-float__head, .gz-float__head:active { cursor:grabbing; }
    .gz-float__title { flex:1 1 auto; font-weight:600; color:#1a2330; display:flex; align-items:center; gap:.35rem; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
    .gz-float__btns { display:flex; gap:2px; flex-shrink:0; }
    .gz-float__btn {
        width:22px; height:22px; padding:0; border:none; background:transparent;
        color:#5b6675; border-radius:4px; line-height:1; cursor:pointer;
        display:inline-flex; align-items:center; justify-content:center;
    }
    .gz-float__btn:hover { background:rgba(15,30,60,.08); color:#1a2330; }
    .gz-float__body { padding:.4rem .35rem; max-height:60vh; overflow-y:auto; }
    .gz-float--collapsed .gz-float__body { display:none; }

    .gz-layers__list { margin:-2px; }
    .gz-layer {
        display:flex; align-items:center; gap:.4rem;
        padding:.25rem .35rem; margin:2px; border-radius:5px;
        cursor:pointer; user-select:none; font-size:.78rem;
        border:1px solid transparent; background:#f8fafc;
        transition:background .1s ease, border-color .1s ease;
    }
    .gz-layer:hover { background:#eef3fb; border-color:#cfe6f3; }
    .gz-layer.is-active { background:#e7efff; border-color:#1a56db; box-shadow:0 0 0 1px #1a56db inset; }
    .gz-layer__icon { flex:0 0 18px; color:#5b6675; text-align:center; font-size:.95rem; }
    .gz-layer.is-active .gz-layer__icon { color:#1a56db; }
    .gz-layer__label { flex:1 1 auto; min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:#1a2330; }
    .gz-layer__label--custom { font-weight:600; color:#0b3da6; }
    .gz-layer__rename {
        flex:1 1 auto; min-width:0; width:100%;
        font:inherit; font-size:.78rem;
        border:1px solid #1a56db; border-radius:4px; outline:none;
        padding:0 .3rem; height:22px; background:#fff; color:#1a2330;
    }
    .gz-layer__rename:focus { box-shadow:0 0 0 2px rgba(26,86,219,.18); }
    .gz-layer__hint { flex:0 0 auto; color:#9aa3af; font-size:.68rem; font-variant-numeric:tabular-nums; }
    .gz-layer__grip { flex:0 0 12px; color:#b5bdc8; font-size:.9rem; cursor:grab; line-height:1; user-select:none; }
    .gz-layer__eye { flex:0 0 16px; color:#5b6675; cursor:pointer; line-height:1; display:inline-flex; align-items:center; justify-content:center; padding:0 2px; border-radius:3px; }
    .gz-layer__eye:hover { color:#1a56db; background:rgba(26,86,219,.08); }
    .gz-layer--hidden { opacity:.55; }
    .gz-layer--hidden .gz-layer__label { color:#7a8699; font-style:italic; }
    .gz-layer--hidden .gz-layer__eye { color:#9aa3af; }
    .gz-layer:active .gz-layer__grip { cursor:grabbing; }
    .gz-layer--dragging { opacity:.4; }
    .gz-layer--drop-before { box-shadow:0 -2px 0 0 #1a56db; }
    .gz-layer--drop-after  { box-shadow:0  2px 0 0 #1a56db; }
    .gz-pages { background:#fff; border-top:1px solid #e3e6ea; padding:.45rem .75rem; display:flex; align-items:center; gap:.6rem; overflow-x:auto; flex-shrink:0; }
    .gz-thumbs { display:flex; gap:.4rem; }
    .gz-thumb { position:relative; width:44px; height:62px; border:1px solid #cdd3da; border-radius:3px; background:#fff; cursor:grab; padding:0; }
    .gz-thumb:active { cursor:grabbing; }
    .gz-thumb--active { border-color:#1a56db; box-shadow:0 0 0 2px rgba(26,86,219,.22); }
    .gz-thumb--dragging { opacity:.45; }
    .gz-thumb--drop-before { box-shadow:-3px 0 0 0 #1a56db; }
    .gz-thumb--drop-after { box-shadow:3px 0 0 0 #1a56db; }
    .gz-thumb__del, .gz-thumb__dup {
        position:absolute; top:-6px;
        width:16px; height:16px; line-height:13px; text-align:center;
        color:#fff; font-size:13px; font-weight:bold;
        border-radius:50%; box-shadow:0 1px 3px rgba(0,0,0,.3);
        cursor:pointer; opacity:0; transition:opacity .12s ease, background .12s ease;
        z-index:2; user-select:none;
    }
    .gz-thumb__del { right:-6px; background:#d63b3b; }
    .gz-thumb__dup { left:-6px; background:#1a56db; }
    .gz-thumb:hover .gz-thumb__del,
    .gz-thumb:hover .gz-thumb__dup,
    .gz-thumb:focus-within .gz-thumb__del,
    .gz-thumb:focus-within .gz-thumb__dup { opacity:1; }
    .gz-thumb__del:hover { background:#9b2030; }
    .gz-thumb__dup:hover { background:#0b3da6; }
    .gz-thumb__sheet { position:absolute; inset:4px; background:#f6f8fa; border-radius:2px; }
    .gz-thumb__num { position:absolute; bottom:1px; right:3px; font-size:.62rem; color:#626976; }
    .gz-empty { color:#828a96; text-align:center; padding:1.5rem .5rem; font-size:.85rem; }
    /* Podglądy szablonów w modalu */
    .gz-tpl { display:flex; flex-direction:column; gap:3px; width:100%; aspect-ratio:.707; background:#fff; border:1px solid #dfe3e8; border-radius:3px; padding:7px; overflow:hidden; }
    .gz-tpl .b { background:#c7ced6; border-radius:1px; height:4px; }
    .gz-tpl .box { background:#eef1f5; border-radius:2px; flex:1; }
    .gz-tpl .row { display:flex; gap:4px; flex:1; }
    .gz-tpl .col { display:flex; flex-direction:column; gap:3px; flex:1; }
    .gz-tpl-title { height:8px; background:#0b1f3a; border-radius:1px; }
    .gz-tpl-card .card-body { padding:.75rem; }
    /* Magazyn mediów */
    .gz-media-item { position:relative; }
    .gz-media-item .gz-media-thumb { width:100%; height:96px; object-fit:contain; background:#f6f8fa; border-radius:3px; display:block; }
    .gz-media-item .gz-media-del { position:absolute; top:4px; right:4px; opacity:0; transition:opacity .12s; z-index:2; }
    .gz-media-item:hover .gz-media-del, .gz-media-item:focus-within .gz-media-del { opacity:1; }
    .gz-media-badge { position:absolute; bottom:4px; left:4px; z-index:2; pointer-events:none; }
    /* Karty szablonów stron użytkownika */
    .gz-ptpl { position:relative; border:1px solid #dfe3e8; border-radius:8px; background:#fff; padding:7px; display:flex; flex-direction:column; gap:6px; height:100%; transition:box-shadow .12s ease, border-color .12s ease; }
    .gz-ptpl:hover { border-color:#1a56db; box-shadow:0 6px 14px rgba(26,86,219,.13); }
    .gz-ptpl__thumb { aspect-ratio:.707; background:#f6f8fa; border:1px solid #eef1f5; border-radius:4px; overflow:hidden; display:flex; align-items:center; justify-content:center; }
    .gz-ptpl__thumb img { max-width:100%; max-height:100%; display:block; }
    .gz-ptpl__name { font-weight:600; font-size:.82rem; color:#1a2330; line-height:1.2; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; padding:1px 4px; border:1px solid transparent; border-radius:4px; }
    .gz-ptpl__name:hover { background:#f3f5f8; cursor:text; }
    .gz-ptpl__name[contenteditable=true] { background:#fff; border-color:#1a56db; outline:none; }
    .gz-ptpl__meta { font-size:.7rem; color:#828a96; display:flex; justify-content:space-between; gap:6px; }
    .gz-ptpl__btns { display:flex; gap:4px; }
    .gz-ptpl__use { flex:1; }
    .gz-ptpl__sizebadge { position:absolute; top:9px; left:9px; background:rgba(255,255,255,.95); color:#5b6675; font-size:.62rem; font-weight:700; padding:1px 5px; border-radius:4px; border:1px solid #e3e6ea; pointer-events:none; z-index:1; }
    .gz-ptpl__empty { padding:24px 12px; text-align:center; color:#828a96; background:#f7f9fc; border:1px dashed #d4dae3; border-radius:8px; font-size:.85rem; }
    /* Chip kategorii na karcie szablonu */
    .gz-ptpl__cat {
        position:absolute; top:9px; right:9px; z-index:1;
        background:#ede9fe; color:#5b21b6; font-size:.62rem; font-weight:700;
        padding:1px 7px; border-radius:999px; border:1px solid #d6c8fd; cursor:pointer;
        max-width:60%; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;
        line-height:1.4;
    }
    .gz-ptpl__cat:hover { background:#ddd6fe; }
    .gz-ptpl__cat--none { background:#f1f3f5; color:#6c7793; border-color:#d8dde5; }
    /* Pasek zakładek (kategorie) */
    .gz-cat-tabs { border-bottom:1px solid #e3e6ea; flex-wrap:nowrap; overflow-x:auto; }
    .gz-cat-tabs::-webkit-scrollbar { height:6px; }
    .gz-cat-tabs::-webkit-scrollbar-thumb { background:#d8dde5; border-radius:3px; }
    .gz-cat-tabs .nav-link {
        padding:.4rem .75rem; font-size:.78rem; color:#5b6675; border:1px solid transparent;
        border-bottom:none; border-radius:6px 6px 0 0; cursor:pointer; white-space:nowrap;
        display:inline-flex; align-items:center; gap:.3rem;
    }
    .gz-cat-tabs .nav-link:hover { background:#f3f5f8; color:#1a2330; }
    .gz-cat-tabs .nav-link.active { background:#fff; color:#5b21b6; border-color:#e3e6ea #e3e6ea #fff; font-weight:700; }
    .gz-cat-tabs .nav-link .gz-tab-cnt { font-size:.65rem; padding:0 5px; background:#eef0f4; color:#5b6675; border-radius:999px; }
    .gz-cat-tabs .nav-link.active .gz-tab-cnt { background:#ede9fe; color:#5b21b6; }
</style>
{% endblock %}

{% block javascripts %}
    <script src="https://cdn.jsdelivr.net/npm/konva@9.3.16/konva.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/pdf-lib@1.17.1/dist/pdf-lib.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@pdf-lib/fontkit@1.1.1/dist/fontkit.umd.min.js"></script>
    {{ parent() }}
{% endblock %}

{% block layout %}
<div class="gz-app"
     data-controller="gazetka-editor"
     data-gazetka-editor-save-url-value="{{ path('app_gazetka_save', {id: newsletter.id}) }}"
     data-gazetka-editor-upload-url-value="{{ path('app_gazetka_upload', {id: newsletter.id}) }}"
     data-gazetka-editor-ai-text-url-value="{{ path('app_gazetka_ai_text', {id: newsletter.id}) }}"
     data-gazetka-editor-ai-redact-url-value="{{ path('app_gazetka_ai_redact', {id: newsletter.id}) }}"
     data-gazetka-editor-ai-image-url-value="{{ path('app_gazetka_ai_image', {id: newsletter.id}) }}"
     data-gazetka-editor-stock-search-url-value="{{ path('app_gazetka_stock_search', {id: newsletter.id}) }}"
     data-gazetka-editor-stock-import-url-value="{{ path('app_gazetka_stock_import', {id: newsletter.id}) }}"
     data-gazetka-editor-media-list-url-value="{{ path('app_gazetka_media_list', {id: newsletter.id}) }}"
     data-gazetka-editor-media-delete-url-value="{{ path('app_gazetka_media_delete', {id: newsletter.id}) }}"
     data-gazetka-editor-blocks-url-value="{{ path('app_gazetka_blocks_list') }}"
    data-gazetka-editor-page-templates-url-value="{{ path('app_gazetka_page_templates_list') }}"
     data-gazetka-editor-import-create-url-value="{{ path('app_gazetka_import_create') }}"
     data-gazetka-editor-csrf-value="{{ csrf_token('gazetka') }}"
     data-gazetka-editor-doc-value="{{ doc }}"
     data-gazetka-editor-initial-template-value="{{ app.request.query.get('template')|default('') }}">

    {# ── Górny pasek ──────────────────────────── #}
    <header class="gz-topbar">
        <a href="{{ path('app_gazetka_index') }}" class="btn btn-sm btn-ghost-secondary px-2" title="Powrót do listy"><i class="ti ti-arrow-left"></i></a>
        <input type="text" class="gz-title" data-gazetka-editor-target="title" value="{{ newsletter.title }}" maxlength="200">
        <span class="gz-status" data-gazetka-editor-target="status">Gotowe</span>

        <div class="ms-auto d-flex align-items-center gap-2">
            <div class="btn-group">
                <button class="btn btn-sm btn-icon btn-ghost-secondary" data-gazetka-editor-target="undoBtn" data-action="gazetka-editor#undo" title="Cofnij (Ctrl+Z)" disabled><i class="ti ti-arrow-back-up"></i></button>
                <button class="btn btn-sm btn-icon btn-ghost-secondary" data-gazetka-editor-target="redoBtn" data-action="gazetka-editor#redo" title="Ponów (Ctrl+Y)" disabled><i class="ti ti-arrow-forward-up"></i></button>
            </div>
            <div class="btn-group">
                <button class="btn btn-sm btn-icon btn-ghost-secondary" data-action="gazetka-editor#zoomOut" title="Pomniejsz"><i class="ti ti-minus"></i></button>
                <span class="btn btn-sm btn-ghost-secondary disabled" style="min-width:52px;" data-gazetka-editor-target="zoomLabel">100%</span>
                <button class="btn btn-sm btn-icon btn-ghost-secondary" data-action="gazetka-editor#zoomIn" title="Powiększ"><i class="ti ti-plus"></i></button>
                <button class="btn btn-sm btn-ghost-secondary" data-action="gazetka-editor#zoomFit" title="Dopasuj"><i class="ti ti-arrows-maximize"></i></button>
            </div>
            <button class="btn btn-sm btn-ghost-secondary" data-bs-toggle="modal" data-bs-target="#gzSpreadModal" title="Podgląd rozkładówki (2 strony obok siebie)"><i class="ti ti-book-2"></i></button>
            <button class="btn btn-sm btn-outline-primary" data-action="gazetka-editor#save"><i class="ti ti-device-floppy me-1"></i>Zapisz</button>
            <div class="dropdown">
                <button class="btn btn-sm btn-ghost-secondary" data-bs-toggle="dropdown" title="Projekt — zapis/wczytanie pliku z grafikami"><i class="ti ti-package me-1"></i>Projekt</button>
                <div class="dropdown-menu dropdown-menu-end">
                    <button class="dropdown-item" data-action="gazetka-editor#exportProject"><i class="ti ti-file-download me-2"></i>Zapisz projekt do pliku (.gazetka)</button>
                    <button class="dropdown-item" data-action="gazetka-editor#pickProjectFile"><i class="ti ti-file-upload me-2"></i>Wczytaj projekt z pliku…</button>
                    <div class="dropdown-divider"></div>
                    <h6 class="dropdown-header">Pojedyncza strona</h6>
                    <button class="dropdown-item" data-action="gazetka-editor#exportCurrentPage"><i class="ti ti-file-export me-2"></i>Zapisz bieżącą stronę (.gazetka-page)</button>
                    <button class="dropdown-item" data-action="gazetka-editor#pickPageFile"><i class="ti ti-file-import me-2"></i>Wstaw stronę z pliku…</button>
                    <div class="dropdown-divider"></div>
                    <h6 class="dropdown-header text-wrap" style="max-width:260px;">„Projekt" zawiera całą gazetkę i tworzy nową gazetkę po wczytaniu. „Strona" zawiera tylko jedną stronę i wstawia ją do bieżącej gazetki (po aktualnej).</h6>
                </div>
            </div>
            <div class="dropdown">
