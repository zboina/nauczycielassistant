                                    <div class="gz-tpl">
                                        <div class="gz-tpl-title" style="width:70%;"></div>
                                        <div class="box" style="flex:1.4;"></div>
                                        <div class="b"></div><div class="b" style="width:90%;"></div><div class="b"></div>
                                    </div>
                                    <div class="fw-bold mt-2">Artykuł ze zdjęciem</div>
                                    <div class="text-secondary small">Zdjęcie u góry, tekst pod spodem.</div>
                                </div>
                            </button>
                        </div>
                        {# Fotorelacja #}
                        <div class="col-6 col-md-4">
                            <button type="button" class="card card-link card-link-pop gz-tpl-card w-100 text-start" data-action="gazetka-editor#applyTemplate" data-gazetka-editor-key-param="photopage" data-bs-dismiss="modal">
                                <div class="card-body">
                                    <div class="gz-tpl">
                                        <div class="gz-tpl-title" style="width:55%;"></div>
                                        <div class="row"><div class="box"></div><div class="box"></div></div>
                                        <div class="row"><div class="box"></div><div class="box"></div></div>
                                    </div>
                                    <div class="fw-bold mt-2">Fotorelacja</div>
                                    <div class="text-secondary small">Siatka czterech zdjęć z podpisami.</div>
                                </div>
                            </button>
                        </div>
                        {# Stopka redakcyjna #}
                        <div class="col-6 col-md-4">
                            <button type="button" class="card card-link card-link-pop gz-tpl-card w-100 text-start" data-action="gazetka-editor#applyTemplate" data-gazetka-editor-key-param="colophon" data-bs-dismiss="modal">
                                <div class="card-body">
                                    <div class="gz-tpl">
                                        <div class="gz-tpl-title" style="width:60%;"></div>
                                        <div class="b" style="width:90%;"></div><div class="b" style="width:70%;"></div>
                                        <div class="b" style="width:80%;"></div><div class="b" style="width:50%;"></div>
                                        <div style="flex:1;"></div>
                                    </div>
                                    <div class="fw-bold mt-2">Stopka redakcyjna</div>
                                    <div class="text-secondary small">Skład redakcji i podziękowania.</div>
                                </div>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# ── Pływający panel warstw (przeciągany; pozycja zapamiętana w localStorage).
         MUSI być wewnątrz elementu z data-controller="gazetka-editor", żeby Stimulus widział target/akcje. #}
    <div class="gz-float gz-float--layers" data-gazetka-editor-target="layers" hidden
         data-action="click->gazetka-editor#onLayerClick">
        <div class="gz-float__head" data-float-drag>
            <span class="gz-float__title"><i class="ti ti-stack-2 me-1"></i>Elementy strony <span class="text-secondary fw-normal" style="font-size:.72rem;" data-layers-count></span></span>
            <div class="gz-float__btns">
                <button type="button" class="gz-float__btn" data-float-collapse title="Zwiń / rozwiń"><i class="ti ti-minus"></i></button>
                <button type="button" class="gz-float__btn" data-action="gazetka-editor#toggleLayersPanel" title="Zamknij"><i class="ti ti-x"></i></button>
            </div>
        </div>
        <div class="gz-float__body" data-float-body>
            <div class="gz-layers__list" data-layers-list></div>
            <div class="gz-layers__empty text-secondary" style="font-size:.72rem;padding:.4rem .55rem;" data-layers-empty>
                Strona pusta — dodaj tekst, grafikę lub ramkę.
            </div>
        </div>
    </div>
</div>
{% endblock %}
