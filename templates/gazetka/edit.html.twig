            <div class="gz-group" data-for="image">
                <div class="gz-tip">
                    <i class="ti ti-info-circle"></i>
                    <span><strong>Dwuklik</strong> = picture-box: przesuwasz obraz w ramce, uchwyty rogów = zoom. <kbd>Esc</kbd> = gotowe.</span>
                </div>

                <details class="gz-sec" open>
                    <summary>
                        <i class="ti ti-crop gz-sec-icon"></i>
                        <span class="gz-sec-title">Kadrowanie</span>
                        <i class="ti ti-chevron-down gz-chev"></i>
                    </summary>
                    <div class="gz-sec__body">
                        <button type="button" class="btn btn-sm btn-outline-primary w-100 mb-1" data-bs-toggle="modal" data-bs-target="#gzCropModal"><i class="ti ti-crop me-1"></i>Kadruj precyzyjnie…</button>
                        <button type="button" class="btn btn-sm btn-ghost-secondary w-100" data-action="gazetka-editor#resetCrop"><i class="ti ti-rotate-2 me-1"></i>Resetuj kadr</button>
                    </div>
                </details>

                <details class="gz-sec" open>
                    <summary>
                        <i class="ti ti-square-rounded gz-sec-icon"></i>
                        <span class="gz-sec-title">Ramka zdjęcia</span>
                        <i class="ti ti-chevron-down gz-chev"></i>
                    </summary>
                    <div class="gz-sec__body">
                        <label class="form-label">Kształt ramki</label>
                        <select class="form-select mb-2" data-prop="frameShape">
                            <optgroup label="Podstawowe">
                                <option value="rect">▭ Prostokąt</option>
                                <option value="circle">⬤ Koło</option>
                                <option value="ellipse">⬭ Owal / elipsa</option>
                            </optgroup>
                            <optgroup label="Wielokąty">
                                <option value="polygon-3">▲ Trójkąt</option>
                                <option value="polygon-4">◆ Romb</option>
                                <option value="polygon-5">⬠ Pięciokąt</option>
                                <option value="polygon-6">⬢ Sześciokąt</option>
                                <option value="polygon-8">⯃ Ośmiokąt</option>
                            </optgroup>
                            <optgroup label="Gwiazdy">
                                <option value="star-5">★ Gwiazda 5-ramienna</option>
                                <option value="star-6">✶ Gwiazda 6-ramienna</option>
                                <option value="star-8">✷ Gwiazda 8-ramienna</option>
                            </optgroup>
                            <optgroup label="Specjalne">
                                <option value="heart">❤ Serce</option>
                                <option value="speech">💬 Dymek</option>
                                <option value="arrow-right">➤ Strzałka</option>
                            </optgroup>
                            <optgroup label="Własny">
                                <option value="custom">✏️ Własny kształt (rysowany)</option>
                            </optgroup>
                        </select>
                        <label class="form-label" data-frameshape-if="rect">Zaokrąglenie rogów</label>
                        <input type="number" class="form-control mb-2" data-prop="cornerRadius" data-type="number" min="0" max="200" placeholder="0" data-frameshape-if="rect">
                        <div data-frameshape-if="custom" class="d-grid gap-1 mb-2">
                            <button type="button" class="btn btn-sm btn-primary" data-action="gazetka-editor#editCustomPoints"><i class="ti ti-vector-bezier-2 me-1"></i>Edytuj punkty kształtu</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary" data-action="gazetka-editor#redrawCustomShape"><i class="ti ti-pencil me-1"></i>Narysuj kształt od nowa…</button>
                            <small class="text-secondary mt-1" style="font-size:.7rem; line-height:1.4;">
                                <strong>Edycja:</strong> przeciągaj wierzchołki · <strong>Alt+klik</strong> na linii = wstaw punkt · <strong>Del / prawy klik</strong> = usuń · Enter = OK · Esc = cofnij.<br>
                                <strong>Rysowanie:</strong> klikaj punkty · Dwuklik / Enter = zakończ · Backspace = cofnij ostatni · Esc = anuluj.
                            </small>
                        </div>
                        <label class="form-check mb-2">
                            <input type="checkbox" class="form-check-input" data-prop="keepRatio">
                            <span class="form-check-label">Zachowaj proporcje przy skalowaniu</span>
                        </label>
                        <button type="button" class="btn btn-sm btn-outline-secondary w-100 mb-2" data-action="gazetka-editor#resetFrameToImageRatio" title="Dopasuje wysokość ramki do proporcji wczytanego zdjęcia (żeby nie było zniekształcone). Środek ramki zostaje na miejscu."><i class="ti ti-aspect-ratio me-1"></i>Dopasuj ramkę do proporcji zdjęcia</button>
                        <label class="form-label">Styl krawędzi</label>
                        <select class="form-select mb-2" data-prop="frameStyle" title="Efekt krawędzi lub dekoracyjna ramka wokół zdjęcia">
                            <option value="none">— Zwykły (gładki) —</option>
                            <optgroup label="Efekty krawędzi">
                                <option value="brush">🖌 Falujące krawędzie</option>
                                <option value="torn">📄 Poszarpane (rwany papier)</option>
                                <option value="fade">🌫 Rozjaśniający się (vignette)</option>
                                <option value="paint">🎨 Gruby pędzel (od środka)</option>
                            </optgroup>
                            <optgroup label="Dekoracyjne ramki (prostokątne)">
                                <option value="stamp">🎟 Znaczek pocztowy (perforacje)</option>
                                <option value="frame">🖼 Złota rama obrazu</option>
                                <option value="brushframe">🖌 Ramka pędzlowa (Freepik-style)</option>
                            </optgroup>
                        </select>
                        <div data-framestyle-if="not-none">
                            <label class="form-label d-flex justify-content-between">
                                <span>Intensywność efektu</span>
                                <span class="text-secondary" data-framestyle-intensity-label>50%</span>
                            </label>
                            <input type="range" class="form-range" data-prop="frameStyleIntensity" data-type="number" min="0" max="100" step="5">
                            <small class="text-secondary" style="font-size:.7rem;">0% = bardzo subtelnie · 50% = domyślnie · 100% = mocno</small>
                        </div>
                    </div>
                </details>

                <details class="gz-sec">
                    <summary>
                        <i class="ti ti-text-wrap gz-sec-icon"></i>
                        <span class="gz-sec-title">Oblewanie tekstem</span>
                        <i class="ti ti-chevron-down gz-chev"></i>
                    </summary>
                    <div class="gz-sec__body">
                        <label class="form-check mb-2">
                            <input type="checkbox" class="form-check-input" data-prop="wrapText">
                            <span class="form-check-label">Tekst oblewa zdjęcie</span>
                        </label>
                        <label class="form-label">Odstęp tekstu od krawędzi (pt)</label>
                        <input type="number" class="form-control mb-2" data-prop="wrapGap" data-type="number" min="0" max="80" placeholder="9">
                        <div class="text-secondary" style="font-size:.7rem; line-height:1.4;">Umieść zdjęcie <strong>wewnątrz</strong> ramki tekstu — gdy jest na środku, tekst popłynie <strong>z obu stron</strong> (efekt DTP).</div>
                    </div>
                </details>

                <details class="gz-sec">
                    <summary>
                        <i class="ti ti-sparkles gz-sec-icon"></i>
                        <span class="gz-sec-title">Efekty</span>
                        <i class="ti ti-chevron-down gz-chev"></i>
                    </summary>
                    <div class="gz-sec__body">
                        <label class="form-check mb-2">
                            <input type="checkbox" class="form-check-input" data-prop="shadow">
                            <span class="form-check-label">Cień pod zdjęciem</span>
                        </label>
                        <label class="form-label d-flex justify-content-between">
                            <span>Krycie (przezroczystość)</span>
                            <span class="text-secondary" data-opacity-label>100%</span>
                        </label>
                        <input type="range" class="form-range" data-prop="opacity" data-type="percent" min="0" max="100" step="1" value="100">
                        <small class="text-secondary" style="font-size:.7rem;">0% = w pełni przezroczyste · 100% = w pełni widoczne. Działa też na zdjęcia z ramkami i efektami krawędzi.</small>
                    </div>
                </details>
            </div>

            {# ─────────────────  IKONA  ───────────────── #}
            <div class="gz-group" data-for="icon">
                <details class="gz-sec" open>
                    <summary>
                        <i class="ti ti-shape gz-sec-icon"></i>
                        <span class="gz-sec-title">Wygląd ikony</span>
                        <i class="ti ti-chevron-down gz-chev"></i>
                    </summary>
                    <div class="gz-sec__body">
                        <div class="gz-row mb-2">
                            <div>
                                <label class="form-label">Kreska</label>
                                <input type="color" class="form-control form-control-color" data-prop="iconColor">
                            </div>
                            <div>
                                <label class="form-label">Wypełnienie</label>
                                <input type="color" class="form-control form-control-color" data-prop="iconFill">
                            </div>
                        </div>
                        <label class="form-check mb-0">
                            <input type="checkbox" class="form-check-input" data-prop="iconFilled">
                            <span class="form-check-label">Wypełnij ikonę (solid)</span>
                        </label>
                    </div>
                </details>

                <details class="gz-sec">
                    <summary>
                        <i class="ti ti-text-wrap gz-sec-icon"></i>
                        <span class="gz-sec-title">Oblewanie tekstem</span>
                        <i class="ti ti-chevron-down gz-chev"></i>
                    </summary>
                    <div class="gz-sec__body">
                        <label class="form-check mb-2">
                            <input type="checkbox" class="form-check-input" data-prop="wrapText">
                            <span class="form-check-label">Tekst oblewa ikonę</span>
                        </label>
                        <label class="form-label">Odstęp (pt)</label>
                        <input type="number" class="form-control mb-0" data-prop="wrapGap" data-type="number" min="0" max="80" placeholder="9">
                    </div>
                </details>

                <details class="gz-sec">
                    <summary>
                        <i class="ti ti-sparkles gz-sec-icon"></i>
                        <span class="gz-sec-title">Efekty</span>
                        <i class="ti ti-chevron-down gz-chev"></i>
                    </summary>
                    <div class="gz-sec__body">
                        <label class="form-check mb-0">
                            <input type="checkbox" class="form-check-input" data-prop="shadow">
                            <span class="form-check-label">Cień</span>
                        </label>
                    </div>
                </details>
            </div>

            {# ─────────  POZYCJA i ROZMIAR (wspólne dla wszystkich)  ───────── #}
            <div class="gz-group" data-for="text image rect line icon">
                <details class="gz-sec" open>
                    <summary>
                        <i class="ti ti-arrows-move gz-sec-icon"></i>
                        <span class="gz-sec-title">Pozycja i rozmiar</span>
                        <i class="ti ti-chevron-down gz-chev"></i>
                    </summary>
                    <div class="gz-sec__body">
                        <div class="gz-row mb-2">
                            <div>
                                <label class="form-label">X (pt)</label>
                                <input type="number" class="form-control" data-prop="x" data-type="number">
                            </div>
                            <div>
                                <label class="form-label">Y (pt)</label>
                                <input type="number" class="form-control" data-prop="y" data-type="number">
                            </div>
                        </div>
                        <div class="gz-row mb-2">
                            <div>
                                <label class="form-label">Szer.</label>
                                <input type="number" class="form-control" data-prop="width" data-type="number">
                            </div>
                            <div>
                                <label class="form-label">Wys.</label>
                                <input type="number" class="form-control" data-prop="height" data-type="number">
                            </div>
                        </div>
                        <label class="form-label">Obrót (°)</label>
                        <input type="number" class="form-control" data-prop="rotation" data-type="number" min="-180" max="180">
                    </div>
                </details>
            </div>
        </aside>
    </div>

    {# ── Strony ───────────────────────────────── #}
    <footer class="gz-pages">
        <span class="text-secondary small" data-gazetka-editor-target="pageInfo" style="min-width:90px;">Strona 1</span>
        <button class="btn btn-sm btn-icon btn-ghost-secondary" data-action="gazetka-editor#prevPage" title="Poprzednia"><i class="ti ti-chevron-left"></i></button>
        <div class="gz-thumbs" data-gazetka-editor-target="thumbs"></div>
        <button class="btn btn-sm btn-icon btn-ghost-secondary" data-action="gazetka-editor#nextPage" title="Następna"><i class="ti ti-chevron-right"></i></button>
        <div class="ms-2 d-flex gap-1">
            <button class="btn btn-sm btn-ghost-primary" data-action="gazetka-editor#addPage"><i class="ti ti-plus me-1"></i>Strona</button>
            <button class="btn btn-sm btn-ghost-primary" data-action="gazetka-editor#duplicatePage" title="Duplikuj bieżącą stronę"><i class="ti ti-copy"></i></button>
            <button class="btn btn-sm btn-ghost-danger" data-action="gazetka-editor#removePage" title="Usuń bieżącą stronę"><i class="ti ti-trash"></i></button>
        </div>
        <button class="btn btn-sm btn-ghost-secondary ms-2" data-action="gazetka-editor#addMarginGuides" title="Marginesy strony — utwórz 4 linie pomocnicze (góra/dół/lewa/prawa)"><i class="ti ti-border-outer me-1"></i>Marginesy</button>
        <button class="btn btn-sm btn-ghost-secondary" data-action="gazetka-editor#clearAllGuides" title="Wyczyść wszystkie linie pomocnicze (PPM na rogu linijek też działa)"><i class="ti ti-eraser me-1"></i>Wyczyść linie</button>
        <button class="btn btn-sm btn-ghost-secondary active ms-2" data-gazetka-editor-target="gridBtn" data-action="gazetka-editor#toggleGrid" title="Siatka i przyciąganie do siatki (włącz/wyłącz)"><i class="ti ti-grid-dots me-1"></i>Siatka</button>
        <div class="d-flex align-items-center gap-1" title="Krok siatki w pt — wpisz własną wartość lub wybierz z listy">
            <input type="number"
                   list="gz-grid-presets"
                   data-gazetka-editor-target="gridSizeInput"
                   data-action="change->gazetka-editor#setGridSize input->gazetka-editor#setGridSize"
                   class="form-control form-control-sm"
                   value="20" min="1" max="500" step="1"
                   style="width:64px;">
            <span class="text-secondary small">pt</span>
            <datalist id="gz-grid-presets">
                <option value="5"></option>
                <option value="10"></option>
                <option value="15"></option>
                <option value="20"></option>
                <option value="25"></option>
                <option value="36"></option>
                <option value="40"></option>
                <option value="50"></option>
                <option value="60"></option>
                <option value="72"></option>
            </datalist>
        </div>
        <button class="btn btn-sm btn-ghost-secondary" data-action="gazetka-editor#openGridConfig" title="Zaawansowana konfiguracja siatki — m.in. dzielenie strony na N podziałów"><i class="ti ti-adjustments"></i></button>
        <select class="form-select form-select-sm" data-pagenum data-action="gazetka-editor#setPageNumbers" title="Numery stron" style="width:auto;">
            <option value="off">Numery: brak</option>
            <option value="center">Numery: środek</option>
            <option value="outer">Numery: do zewnątrz</option>
        </select>
        <button class="btn btn-sm btn-ghost-secondary ms-2" data-gazetka-editor-target="layersBtn" data-action="gazetka-editor#toggleLayersPanel" title="Panel elementów strony (warstwy)"><i class="ti ti-stack-2 me-1"></i>Warstwy</button>
        <label class="ms-auto d-flex align-items-center gap-1 small text-secondary">
            Tło strony
            <input type="color" class="form-control form-control-color" value="#ffffff" data-action="gazetka-editor#setBackground" style="width:36px;height:30px;padding:2px;">
        </label>
    </footer>

    <input type="file" accept="image/jpeg,image/png,image/webp,image/gif" hidden
           data-gazetka-editor-target="file" data-action="change->gazetka-editor#onFileChosen">
    <input type="file" accept=".json,.gazetka,application/json" hidden
           data-gazetka-editor-target="projectFile" data-action="change->gazetka-editor#onProjectChosen">
    <input type="file" accept=".json,.gazetka-page,application/json" hidden
           data-gazetka-editor-target="pageFile" data-action="change->gazetka-editor#onPageChosen">

    {# ── Modal: podgląd rozkładówki ────────────── #}
    <div class="modal modal-blur fade" id="gzSpreadModal" tabindex="-1">
        <div class="modal-dialog modal-xl modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="ti ti-book-2 me-2"></i>Podgląd rozkładówki</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="d-flex gap-3 align-items-end mb-3 flex-wrap">
                        <div>
                            <label class="form-label">Lewa strona</label>
                            <select class="form-select" data-spread="left" data-action="change->gazetka-editor#renderSpread" style="width:auto;"></select>
                        </div>
                        <div>
                            <label class="form-label">Prawa strona</label>
                            <select class="form-select" data-spread="right" data-action="change->gazetka-editor#renderSpread" style="width:auto;"></select>
                        </div>
